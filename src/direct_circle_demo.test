#include <Arduino.h>
#include <Wire.h>

// Define your display dimensions
#define DISPLAY_WIDTH 320
#define DISPLAY_HEIGHT 240

// I2C Joystick Controller Pins (using SPI pins as GPIO)
#define JOYSTICK_SDA 19   // SPI bus read data pin
#define JOYSTICK_SCL 18   // SPI bus clock pin
#define JOYSTICK_CS  27   // SPI peripheral chip selection signal

// Basic color definitions for 16-bit RGB
#define BLACK   0x0000
#define WHITE   0xFFFF
#define RED     0xF800
#define GREEN   0x07E0
#define BLUE    0x001F
#define YELLOW  0xFFE0

// Simple framebuffer approach (simulates display memory)
// In a real implementation, you'd interface with actual display hardware
static uint16_t framebuffer[DISPLAY_WIDTH * DISPLAY_HEIGHT];

// Function to set a pixel in framebuffer
void setPixel(int16_t x, int16_t y, uint16_t color) {
  if (x >= 0 && x < DISPLAY_WIDTH && y >= 0 && y < DISPLAY_HEIGHT) {
    framebuffer[y * DISPLAY_WIDTH + x] = color;
  }
}

// Function to get a pixel from framebuffer
uint16_t getPixel(int16_t x, int16_t y) {
  if (x >= 0 && x < DISPLAY_WIDTH && y >= 0 && y < DISPLAY_HEIGHT) {
    return framebuffer[y * DISPLAY_WIDTH + x];
  }
  return BLACK;
}

// Method 1: Bresenham's circle algorithm (most efficient)
void drawCircleBresenham(int16_t x0, int16_t y0, int16_t radius, uint16_t color) {
  int16_t x = radius;
  int16_t y = 0;
  int16_t err = 0;

  while (x >= y) {
    // Plot pixels in all 8 octants
    setPixel(x0 + x, y0 + y, color);
    setPixel(x0 + y, y0 + x, color);
    setPixel(x0 - y, y0 + x, color);
    setPixel(x0 - x, y0 + y, color);
    setPixel(x0 - x, y0 - y, color);
    setPixel(x0 - y, y0 - x, color);
    setPixel(x0 + y, y0 - x, color);
    setPixel(x0 + x, y0 - y, color);

    if (err <= 0) {
      y++;
      err += 2 * y + 1;
    } else {
      x--;
      err -= 2 * x + 1;
    }
  }
}

// Method 2: Midpoint circle algorithm
void drawCircleMidpoint(int16_t x0, int16_t y0, int16_t radius, uint16_t color) {
  int16_t x = 0;
  int16_t y = radius;
  int16_t d = 5 - 4 * radius;

  while (x <= y) {
    // Plot all 8 octants
    setPixel(x0 + x, y0 + y, color);
    setPixel(x0 + x, y0 - y, color);
    setPixel(x0 - x, y0 + y, color);
    setPixel(x0 - x, y0 - y, color);
    setPixel(x0 + y, y0 + x, color);
    setPixel(x0 + y, y0 - x, color);
    setPixel(x0 - y, y0 + x, color);
    setPixel(x0 - y, y0 - x, color);

    if (d < 0) {
      d += 8 * x + 12;
    } else {
      d += 8 * (x - y) + 20;
      y--;
    }
    x++;
  }
}

// Method 3: Simple circle using trigonometric functions
void drawCircleTrig(int16_t x0, int16_t y0, int16_t radius, uint16_t color) {
  const float PI = 3.14159265359;
  const int steps = 100; // Number of points to draw
  
  for (int i = 0; i < steps; i++) {
    float angle = 2 * PI * i / steps;
    int16_t x = x0 + radius * cos(angle);
    int16_t y = y0 + radius * sin(angle);
    setPixel(x, y, color);
  }
}

// Method 4: Fill circle using scanlines
void fillCircle(int16_t x0, int16_t y0, int16_t radius, uint16_t color) {
  // Draw horizontal lines for filled circle
  for (int16_t y = -radius; y <= radius; y++) {
    int16_t x = sqrt(radius * radius - y * y);
    for (int16_t i = -x; i <= x; i++) {
      setPixel(x0 + i, y0 + y, color);
    }
  }
}

// Method 5: Draw circle with thick outline
void drawThickCircle(int16_t x0, int16_t y0, int16_t radius, int16_t thickness, uint16_t color) {
  for (int i = 0; i < thickness; i++) {
    drawCircleBresenham(x0, y0, radius + i, color);
  }
}

// Clear the entire framebuffer
void clearScreen(uint16_t color) {
  for (int i = 0; i < DISPLAY_WIDTH * DISPLAY_HEIGHT; i++) {
    framebuffer[i] = color;
  }
}

// Function to simulate sending framebuffer to display
// In a real implementation, this would interface with your actual display hardware
void updateDisplay() {
  // This would normally interface with your display hardware
  // For example, sending data to SPI pins or I2C interface
  // This is a placeholder for actual display update code
  Serial.println("Display updated with framebuffer data");
}

// Initialize I2C joystick controller
void initJoystick() {
  // Configure joystick pins as GPIO
  pinMode(JOYSTICK_SDA, INPUT);
  pinMode(JOYSTICK_SCL, INPUT);
  pinMode(JOYSTICK_CS, INPUT);
  
  // Initialize I2C bus
  Wire.begin(JOYSTICK_SDA, JOYSTICK_SCL);
  Serial.println("I2C Joystick initialized");
}

// Read joystick position
void readJoystick(int16_t* x, int16_t* y, bool* button) {
  // This would normally read from the I2C joystick controller
  // For demo purposes, we'll simulate joystick readings
  
  // Simulate joystick readings
  static unsigned long lastRead = 0;
  unsigned long now = millis();
  
  if (now - lastRead > 100) {  // Read every 100ms
    *x = (analogRead(34) - 2048) / 10;  // Simulate X position
    *y = (analogRead(35) - 2048) / 10;  // Simulate Y position
    *button = digitalRead(JOYSTICK_CS) == LOW;  // Simulate button press
    
    printf("Joystick X: %d, Y: %d, Button: %s\n", *x, *y, *button ? "Pressed" : "Released");
    lastRead = now;
  }
}

// Update circle position based on joystick input
void updateCirclePosition(int16_t* circleX, int16_t* circleY, int16_t* lastX, int16_t* lastY) {
  int16_t x, y;
  bool button;
  
  readJoystick(&x, &y, &button);
  
  // Update circle position based on joystick
  *circleX += x / 10;
  *circleY += y / 10;
  
  // Keep circle within display bounds
  if (*circleX < 0) *circleX = 0;
  if (*circleX >= DISPLAY_WIDTH) *circleX = DISPLAY_WIDTH - 1;
  if (*circleY < 0) *circleY = 0;
  if (*circleY >= DISPLAY_HEIGHT) *circleY = DISPLAY_HEIGHT - 1;
  
  // Update last position for animation effect
  *lastX = *circleX;
  *lastY = *circleY;
}

void setup() {
  Serial.begin(115200);
  
  // Initialize display
  Serial.println("Initializing display...");
  
  // Initialize I2C joystick
  initJoystick();
  
  // Clear screen
  clearScreen(BLACK);
  
  // Demonstrate different circle drawing methods
  Serial.println("Drawing circles...");
  
  // Draw a filled circle
  fillCircle(160, 120, 50, RED);
  
  // Draw outline circles
  drawCircleBresenham(160, 120, 50, WHITE);
  drawCircleBresenham(160, 120, 60, GREEN);
  
  // Draw multiple circles with different methods
  drawCircleMidpoint(100, 100, 30, BLUE);
  drawCircleTrig(220, 100, 30, YELLOW);
  
  // Draw thick circle
  drawThickCircle(160, 200, 20, 5, CYAN);
  
  // Update display
  updateDisplay();
  
  Serial.println("Circle drawing complete!");
  Serial.println("Joystick control enabled - move joystick to control circle position");
}

void loop() {
  static int16_t circleX = 160;
  static int16_t circleY = 120;
  static int16_t lastX = 160;
  static int16_t lastY = 120;
  
  // Clear screen for animation
  clearScreen(BLACK);
  
  // Update circle position based on joystick
  updateCirclePosition(&circleX, &circleY, &lastX, &lastY);
  
  // Draw animated circle
  drawCircleBresenham(circleX, circleY, 30, YELLOW);
  
  // Update display
  updateDisplay();
  
  delay(50);  // Small delay for smooth animation
}