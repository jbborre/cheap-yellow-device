// clang++ -std=c++11 -x c++ test_apps/game_audio_logic.inotest -o /tmp/game-audio-test && /tmp/game-audio-test
#include <cassert>
#include <cstdio>
#include <cstdint>
#define GAME_AUDIO_HOST_TEST
uint32_t clockMs=0;
uint32_t millis() { return clockMs; }
#include "../include/GameAudio.h"
int main() {
  using namespace GameAudio;
  begin();
  play(Start); assert(outputHz==392);
  clockMs=110; update(clockMs); assert(outputHz==523);
  clockMs=210; update(clockMs); assert(outputHz==784);
  clockMs=310; update(clockMs); assert(outputHz==0 && !playing);
  engine(20); update(clockMs); assert(outputHz==320);
  play(Crash); assert(outputHz==160);
  play(Shot); assert(current==Crash); // minor effects cannot mask damage
  clockMs+=300; update(clockMs); assert(outputHz==320); // engine resumes
  play(Warning); play(Hit); assert(current==Warning);
  play(Lose); assert(current==Lose); // results override warnings
  setEnabled(false); assert(outputHz==0 && !playing);
  play(Win); engine(30); update(clockMs); assert(outputHz==0);
  setEnabled(true); update(clockMs); assert(outputHz==0); // no stale effects
  clockMs=UINT32_MAX-30; play(Shot);
  clockMs=10; update(clockMs); assert(outputHz==800); // clock rollover
  stop(); assert(outputHz==0 && engineHz==0 && !playing);
  for(int i=Click;i<=Test;++i) {
    play(static_cast<Effect>(i));
    assert(outputHz>=130);
    clockMs+=2000; update(clockMs);
    assert(outputHz==0 && !playing);
  }
  play(Shot);
  uint16_t frequency=outputHz;
  setVolume(2); assert(volumePercent()==25 && outputHz==frequency && outputVolume==2);
  setVolume(0); assert(outputHz==0 && !playing && enabled);
  play(Shot); engine(20); update(clockMs); assert(outputHz==0 && !playing);
  setVolume(3); assert(volumePercent()==50);
  play(Shot); assert(outputHz==1400);
  setVolume(20); assert(volumePercent()==100);
  setVolume(-5); assert(volumePercent()==0 && outputHz==0);
  setEnabled(false); setVolume(4); update(clockMs); assert(outputHz==0);
  puts("Audio timing, priority, volume, engine, mute and rollover checks passed");
}
