#include <TFT_eSPI.h>
#include <SPI.h>
#include <XPT2046_Touchscreen.h>

// Define the CS pin for the touch controller (adjust if needed)
#define XPT2046_CS 15

TFT_eSPI tft = TFT_eSPI();
XPT2046_Touchscreen ts(XPT2046_CS);

// ---------------- STATE ----------------
enum State { SPLASH, GAME, GAME_OVER };
State state = SPLASH;

// Button rectangles
int btnX = 0, btnY = 0, btnW = 0, btnH = 0;

// Game vars
int score = 0;
unsigned long gameStartTime = 0;
const unsigned long GAME_DURATION = 30000; // 30 seconds

// Bird class
struct Bird {
  float x, y;
  float velX, velY;
  bool isTurkey;    // true = turkey (ground), false = duck (sky)
  bool alive;
  int frame;        // animation frame
  unsigned long lastFrameChange;
  float speed;
};

const int MAX_BIRDS = 8;
Bird birds[MAX_BIRDS];

// Touch tracking
int lastTouchX = -1, lastTouchY = -1;
bool touching = false;
bool wasTouching = false;

// ---------------- TOUCH HELPERS ----------------
bool getTouch(int &x, int &y, bool &touched) {
  TS_Point p = ts.getPoint();
  if (p.z > 200 && p.z < 4000) {
    // Map the 0-4095 range to your screen dimensions
    // Adjust these if your coordinates are flipped/wrong
    x = map(p.x, 0, 4095, 0, TFT_WIDTH);
    y = map(p.y, 0, 4095, 0, TFT_HEIGHT);
    touched = true;
  } else {
    touched = false;
  }
  return touched;
}

bool inButton(int x, int y) {
  return x >= btnX && x <= btnX + btnW &&
         y >= btnY && y <= btnY + btnH;
}

// ---------------- TEXT / BUTTON ----------------
void centerText(const char* text, int yCenter, int16_t fg, int16_t bg) {
  int w = tft.textWidth(text);
  tft.setTextColor(fg, bg);
  tft.drawString(text, TFT_WIDTH / 2 - w / 2, yCenter - 8);
}

void drawButton(int x, int y, int w, int h, const char* label,
                uint16_t bg, uint16_t fg, bool highlight = false) {
  uint16_t fill = highlight ? tft.color565(0, 255, 0) : bg;
  tft.fillRoundRect(x, y, w, h, 8, fill);
  centerText(label, y + h / 2, fg, fill);
  btnX = x; btnY = y; btnW = w; btnH = h;
}

// ---------------- SPRITE DRAWING ----------------
void drawDuck(float x, float y, int frame) {
  int ix = (int)x, iy = (int)y;
  // Body
  tft.fillRoundRect(ix - 8, iy - 4, 16, 8, 3, TFT_YELLOW);
  // Head
  tft.fillCircle(ix + 6, iy - 6, 4, TFT_YELLOW);
  // Beak
  tft.fillTriangle(ix + 9, iy - 6, ix + 14, iy - 5, ix + 9, iy - 4, TFT_ORANGE);
  // Eye
  tft.fillCircle(ix + 7, iy - 7, 1, TFT_BLACK);
  // Wing (flapping)
  if (frame % 2 == 0) {
    tft.fillTriangle(ix - 4, iy - 4, ix + 2, iy - 10, ix + 4, iy - 4, TFT_ORANGE);
  } else {
    tft.fillTriangle(ix - 4, iy - 4, ix + 2, iy - 2, ix + 4, iy - 4, TFT_ORANGE);
  }
  // Tail
  tft.fillTriangle(ix - 8, iy - 4, ix - 14, iy - 8, ix - 8, iy, TFT_YELLOW);
}

void drawTurkey(float x, float y, int frame) {
  int ix = (int)x, iy = (int)y;
  // Body
  tft.fillEllipse(ix, iy, 12, 8, TFT_BROWN);
  // Head
  tft.fillCircle(ix + 10, iy - 8, 4, TFT_RED);
  // Snood
  tft.fillCircle(ix + 12, iy - 4, 2, TFT_RED);
  // Eye
  tft.fillCircle(ix + 11, iy - 9, 1, TFT_BLACK);
  // Tail feathers
  int featherColors[5] = {TFT_RED, TFT_ORANGE, TFT_YELLOW, TFT_GREEN, TFT_BLUE};
  for (int i = 0; i < 5; i++) {
    int fx = ix - 8 + i * 3;
    tft.fillTriangle(fx, iy - 4, fx + 1, iy - 14, fx + 2, iy - 4, featherColors[i]);
  }
  // Legs
  tft.drawPixel(ix - 3, iy + 8, TFT_ORANGE);
  tft.drawPixel(ix + 3, iy + 8, TFT_ORANGE);
}

void drawBird(Bird& bird) {
  if (!bird.alive) return;
  if (bird.isTurkey) {
    drawTurkey(bird.x, bird.y, bird.frame);
  } else {
    drawDuck(bird.x, bird.y, bird.frame);
  }
}

// ---------------- SPLASH SCREEN ----------------
void showSplash() {
  state = SPLASH;
  tft.fillScreen(TFT_BLACK);

  // Sky
  tft.fillRect(0, 0, TFT_WIDTH, TFT_HEIGHT / 2, tft.color565(135, 206, 235));
  // Ground
  tft.fillRect(0, TFT_HEIGHT / 2, TFT_WIDTH, TFT_HEIGHT / 2, tft.color565(34, 139, 34));

  tft.setTextSize(4);
  centerText("Duck Hunt", TFT_HEIGHT / 4, TFT_YELLOW, tft.color565(135, 206, 235));

  tft.setTextSize(2);
  centerText("Shoot: Duck (1pt)", TFT_HEIGHT / 2 - 20, TFT_WHITE, tft.color565(34, 139, 34));
  centerText("Turkey (2pts)", TFT_HEIGHT / 2, TFT_WHITE, tft.color565(34, 139, 34));

  tft.setTextSize(1);
  centerText("Tap START to play!", TFT_HEIGHT / 2 + 30, TFT_CYAN, tft.color565(34, 139, 34));

  int bx = TFT_WIDTH / 2 - 60, by = TFT_HEIGHT / 2 + 50;
  drawButton(bx, by, 120, 44, "START", TFT_GREEN, TFT_WHITE);
}

// ---------------- GAME ----------------
void startGame() {
  state = GAME;
  score = 0;
  gameStartTime = millis();
  
  for (int i = 0; i < MAX_BIRDS; i++) {
    birds[i].alive = false;
  }
  
  spawnBird(true);
  spawnBird(false);
  renderGame();
}

void spawnBird(bool isDuck) {
  for (int i = 0; i < MAX_BIRDS; i++) {
    if (!birds[i].alive) {
      birds[i].isTurkey = !isDuck;
      birds[i].alive = true;
      birds[i].frame = 0;
      birds[i].lastFrameChange = millis();
      birds[i].speed = 1.0 + random(0, 20) / 10.0f;
      
      if (isDuck) {
        // Duck flies across the sky
        birds[i].y = random(30, TFT_HEIGHT / 2 - 30);
        if (random(0, 2) == 0) {
          birds[i].x = -20;
          birds[i].velX = birds[i].speed;
        } else {
          birds[i].x = TFT_WIDTH + 20;
          birds[i].velX = -birds[i].speed;
        }
        birds[i].velY = 0.2f * (random(0, 2) ? 1 : -1);
      } else {
        // Turkey walks on the ground
        birds[i].y = TFT_HEIGHT - 20;
        if (random(0, 2) == 0) {
          birds[i].x = -20;
          birds[i].velX = birds[i].speed * 0.5;
        } else {
          birds[i].x = TFT_WIDTH + 20;
          birds[i].velX = -birds[i].speed * 0.5;
        }
        birds[i].velY = 0;
      }
      return;
    }
  }
}

void renderGame() {
  // Sky
  tft.fillRect(0, 0, TFT_WIDTH, TFT_HEIGHT / 2, tft.color565(135, 206, 235));
  // Ground
  tft.fillRect(0, TFT_HEIGHT / 2, TFT_WIDTH, TFT_HEIGHT / 2, tft.color565(34, 139, 34));
  
  // Draw birds
  for (int i = 0; i < MAX_BIRDS; i++) {
    drawBird(birds[i]);
  }
  
  // Score
  tft.setTextSize(2);
  centerText("Score: " + String(score), 10, TFT_YELLOW, tft.color565(135, 206, 235));
  
  // Timer
  unsigned long remaining = GAME_DURATION - (millis() - gameStartTime);
  if (remaining < 0) remaining = 0;
  int seconds = remaining / 1000;
  centerText("Time: " + String(seconds), 30, TFT_WHITE, tft.color565(135, 206, 235));
}

void showGameOver() {
  state = GAME_OVER;
  tft.fillScreen(TFT_BLACK);

  tft.setTextSize(5);
  centerText("GAME OVER", 50, TFT_RED, TFT_BLACK);

  tft.setTextSize(3);
  centerText("Score: " + String(score), 110, TFT_YELLOW, TFT_BLACK);

  tft.setTextSize(1);
  centerText("Tap RESTART to play again", 150, TFT_CYAN, TFT_BLACK);

  int bx = TFT_WIDTH / 2 - 60, by = 170;
  drawButton(bx, by, 120, 44, "RESTART", TFT_GREEN, TFT_WHITE);
}

// ---------------- GAME LOGIC ----------------
void updateBirds() {
  for (int i = 0; i < MAX_BIRDS; i++) {
    Bird& bird = birds[i];
    if (!bird.alive) continue;
    
    bird.x += bird.velX;
    bird.y += bird.velY;
    
    // Duck bounces slightly vertically
    if (!bird.isTurkey) {
      if (bird.y < 20 || bird.y > TFT_HEIGHT / 2 - 20) {
        bird.velY *= -1;
      }
    }
    
    // Animation frame
    if (millis() - bird.lastFrameChange > 200) {
      bird.frame++;
      bird.lastFrameChange = millis();
    }
    
    // Remove if off screen
    if (bird.x < -30 || bird.x > TFT_WIDTH + 30) {
      bird.alive = false;
      if (random(0, 100) > 50) {
        spawnBird(bird.isTurkey);
      }
    }
  }
}

void checkShoot(int tx, int ty) {
  for (int i = 0; i < MAX_BIRDS; i++) {
    Bird& bird = birds[i];
    if (!bird.alive) continue;
    
    float dx = tx - bird.x;
    float dy = ty - bird.y;
    float dist = sqrt(dx * dx + dy * dy);
    
    if (dist < 15) {
      bird.alive = false;
      score += bird.isTurkey ? 2 : 1;
      
      // Explosion effect
      tft.fillCircle(bird.x, bird.y, 10, TFT_ORANGE);
      tft.fillCircle(bird.x, bird.y, 5, TFT_RED);
      
      delay(100);
      spawnBird(bird.isTurkey);
    }
  }
}

// ---------------- LOOP ----------------
void loop() {
  int tx, ty;
  bool t = getTouch(tx, ty, touching);

  if (state == SPLASH) {
    if (t && inButton(tx, ty)) {
      drawButton(btnX, btnY, btnW, btnH, "START", TFT_GREEN, TFT_WHITE, true);
    }
    if (wasTouching && !touching) {
      if (lastTouchX >= btnX && lastTouchX <= btnX + btnW &&
          lastTouchY >= btnY && lastTouchY <= btnY + btnH) {
        startGame();
      }
    }
    wasTouching = touching;
    if (t) { lastTouchX = tx; lastTouchY = ty; }
    delay(20);

  } else if (state == GAME) {
    if (millis() - gameStartTime >= GAME_DURATION) {
      showGameOver();
      delay(300);
      return;
    }
    
    updateBirds();
    
    if (t) {
      checkShoot(tx, ty);
    }
    
    renderGame();
    delay(30);

  } else if (state == GAME_OVER) {
    if (t && inButton(tx, ty)) {
      drawButton(btnX, btnY, btnW, btnH, "RESTART", TFT_GREEN, TFT_WHITE, true);
      while (ts.getPoint().z > 200) delay(10);
      startGame();
    }
    delay(20);
  }
}

void setup() {
  tft.init();
  tft.setRotation(1);
  ts.begin();
  showSplash();
}


