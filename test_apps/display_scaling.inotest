// clang++ -std=c++11 -x c++ test_apps/display_scaling.inotest -o /tmp/display-test && /tmp/display-test
#include <cassert>
#include <initializer_list>
#include <cstdio>
#define GAME_DISPLAY_HOST_TEST
#include "../include/GameDisplay.h"
int main() {
  using namespace GameDisplay;
  // Every displayed pixel maps back to its source pixel for touch hit testing.
  for (int panelWidth : {320,480}) {
    uint8_t source[width], output[maxPanelWidth];
    for (int x=0;x<width;++x) source[x]=(x*37)%256;
    scaleRow(source,output,panelWidth);
    for (int px=0;px<panelWidth;++px) {
      int logical=logicalCoordinate(px,panelWidth,width);
      assert(logical>=0 && logical<width);
      assert(output[px]==source[logical]);
    }
    assert(logicalCoordinate(-20,panelWidth,width)==0);
    assert(logicalCoordinate(panelWidth+20,panelWidth,width)==319);
  }
  // Exercise every logical row and the bottom controls at both resolutions.
  for (int panelHeight : {240,320}) {
    bool seen[height]={};
    for (int py=0;py<panelHeight;++py) seen[logicalCoordinate(py,panelHeight,height)]=true;
    for (bool row:seen) assert(row);
    assert(logicalCoordinate(panelHeight-1,panelHeight,height)==239);
  }
  // Zombie Crash's attack button (253..311,190..235) at physical coordinates.
  assert(logicalCoordinate(420,480,width)==280);
  assert(logicalCoordinate(280,320,height)==210);
  puts("Display scaling checks passed");
}
