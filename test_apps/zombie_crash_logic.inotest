// Host-side gameplay regression checks; not compiled into the ESP32 firmware.
// Run: clang++ -std=c++11 -x c++ test_apps/zombie_crash_logic.inotest -o /tmp/zombie-crash-test && /tmp/zombie-crash-test
#include <algorithm>
#include <cassert>
#include <cmath>
#include <cstdint>
#include <cstdio>
using std::min;
using std::max;
template<class T> T constrain(T value, T lo, T hi) { return min(hi,max(lo,value)); }
long random(long lo, long hi) { return lo+(hi-lo)/2; }
struct TouchButton {
  int16_t x,y,w,h;
  bool contains(uint16_t tx,uint16_t ty) const { return tx>=x && tx<x+w && ty>=y && ty<y+h; }
};
constexpr int TFT_WHITE=65535,TFT_BLACK=0,TFT_RED=0xF800,COLOR_GOLD=0xFEA0,COLOR_MINT=0x5FFC;
struct Renderer {
#define DRAW_STUB(name) template<typename... Args> void name(Args...) {}
  DRAW_STUB(fillRoundRect) DRAW_STUB(drawRoundRect) DRAW_STUB(setTextColor)
  DRAW_STUB(drawCentreString) DRAW_STUB(fillEllipse) DRAW_STUB(drawWideLine)
  DRAW_STUB(drawCircle) DRAW_STUB(fillCircle) DRAW_STUB(fillRect) DRAW_STUB(drawLine)
  DRAW_STUB(drawFastVLine) DRAW_STUB(fillTriangle) DRAW_STUB(fillSprite)
  DRAW_STUB(drawString) DRAW_STUB(drawRect) DRAW_STUB(drawRightString) DRAW_STUB(pushSprite)
#undef DRAW_STUB
} gameFrame;
constexpr int ZOMBIE_CRASH=6;
int gameState=0;
void drawGameList() { gameState=1; }
#define GAME_AUDIO_HOST_TEST
uint32_t millis() { return 0; }
#include "../include/ZombieCrash.h"

int main() {
  using namespace ZombieCrash;
  // Selection requires separate presses and keeps the chosen appearance/weapon.
  beginZombieCrash();
  assert(stage==CHARACTER_SELECT);
  updateZombieCrash(10,true,true,200,100);
  assert(stage==WEAPON_SELECT && female);
  updateZombieCrash(20,true,false,200,100);
  assert(stage==WEAPON_SELECT);
  updateZombieCrash(30,true,true,200,100);
  assert(stage==ACTIVE_LEVEL && bow && life==5);
  // Hold movement, release to stop, then change direction.
  updateZombieCrash(100,true,false,100,210);
  float moved=playerX;
  assert(moved>60 && facing==1);
  updateZombieCrash(150,false,false,0,0);
  assert(playerX==moved);
  updateZombieCrash(200,true,false,30,210);
  assert(playerX<moved && facing==-1);
  // Sword: one hit kills; a target behind the hero is unharmed.
  startLevel(0); bow=false;
  zombies[0]={playerX+40,0,0,2};
  zombies[1]={playerX-40,0,0,2};
  step(0.01f,0,true);
  assert(zombies[0].hp==0 && kills==1 && zombies[1].hp==2);
  zombies[2]={playerX+40,0,0,2};
  step(0.1f,0,true);
  assert(zombies[2].hp==2); // held button respects the attack cooldown
  step(0.3f,0,true);
  assert(zombies[2].hp==0 && kills==2 && zombies[1].hp==2);
  // Bow projectiles travel to the nearest target and do not pierce it.
  startLevel(0); bow=true;
  zombies[0]={playerX+100,0,0,2};
  zombies[1]={playerX+145,0,0,2};
  step(0.01f,0,true);
  for(int i=0;i<10;++i) step(0.05f,0,false);
  assert(zombies[0].hp==1 && zombies[1].hp==2);
  step(0.01f,0,true);
  for(int i=0;i<10;++i) step(0.05f,0,false);
  assert(zombies[0].hp==0 && kills==1 && zombies[1].hp==2);
  // Contact is rate-limited, and five separate hits end the run.
  startLevel(0);
  zombies[0]={playerX,0,0,2};
  step(0.01f,0,false); assert(life==5); // wind-up is harmless
  step(0.61f,0,false); assert(life==4);
  step(0.1f,0,false); assert(life==4);
  for(int i=0;i<4;++i) {
    immunity=0; zombies[0].x=playerX; zombies[0].attackTimer=0.251f;
    step(0.01f,0,false);
  }
  assert(stage==DEFEAT && life==0);
  // Entering the arena starts the five-second summon clock.
  startLevel(0); playerX=arenaStart+41;
  step(0.01f,0,false);
  assert(bossActive && bossLife==10);
  for(int i=0;i<49;++i) step(0.1f,0,false);
  int alive=0;
  for(const auto &z:zombies) if(z.hp>0) ++alive;
  assert(alive==0);
  step(0.1f,0,false);
  alive=0;
  for(const auto &z:zombies) if(z.hp>0) { ++alive; assert(z.hp==2 && z.rising>0); }
  assert(alive==2);
  // A second summon occurs five seconds later even with existing minions.
  for(int i=0;i<50;++i) { immunity=1; step(0.1f,0,false); }
  alive=0;
  for(const auto &z:zombies) if(z.hp>0) ++alive;
  assert(alive==4);
  // The Chieftain takes five sword hits, then unlocks Iceland.
  startLevel(0); bow=false; bossActive=true; bossX=playerX=arenaStart+100;
  bossX+=50;
  for(int i=0;i<4;++i) step(0.4f,0,true);
  assert(bossLife==2 && stage==ACTIVE_LEVEL);
  step(0.4f,0,true);
  assert(bossLife==0 && stage==LEVEL_COMPLETE);
  updateZombieCrash(5000,true,true,100,140);
  assert(level==2 && stage==ACTIVE_LEVEL && life==5 && !bossActive);
  // Warlord health is exactly five sword hits or ten arrow hits.
  for(int weapon=0;weapon<2;++weapon) {
    startLevel(0,2); bow=weapon!=0;
    bossActive=true; playerX=arenaStart+100; bossX=playerX+50;
    int hits=bow ? 10 : 5;
    for(int hit=1;hit<=hits;++hit) {
      attackCooldown=0;
      attack();
      if(bow) { // Advance only projectiles/combat; keep hazards out of this check.
        immunity=10; spikeTimer=100;
        step(0.1f,0,false); step(0.1f,0,false);
      }
      assert(bossLife==10-hit*(bow ? 1 : 2));
      assert(stage==(hit==hits ? LEVEL_COMPLETE : ACTIVE_LEVEL));
    }
  }
  // Melee wind-up can be dodged, and damage coincides with the swipe.
  startLevel(0,2);
  zombies[0]={playerX,0,0,2};
  step(0.01f,0,false);
  assert(zombies[0].attackTimer>0 && life==5);
  for(int i=0;i<9;++i) step(0.1f,1,false);
  assert(life==5);
  // Ranged zombies fire automatically; the shot rises then falls toward a
  // fixed location. Standing still is hit; moving in either direction dodges.
  for(int movement=-1;movement<=1;++movement) {
    startLevel(0,2); playerX=350;
    zombies[0]={playerX+150,0,0,2,true,0,0};
    step(0.01f,0,false);
    assert(spit[0].active && spit[0].vy<0);
    float aim=spit[0].vx;
    for(int i=0;i<15;++i) {
      step(0.1f,movement,false);
      assert(spit[0].vx==aim); // not a homing projectile
    }
    assert(life==(movement==0 ? 4 : 5));
  }
  // Warning markers are harmless, then the spikes erupt and hurt once.
  startLevel(0,2); spikes[0]={playerX,spikeWarning+spikeDuration,true};
  updateHazards(1.0f); assert(life==5);
  updateHazards(0.25f); assert(life==4);
  updateHazards(0.1f); assert(life==4);
  updateHazards(0.6f); assert(!spikes[0].active);
  // Either direction clears a marked spot before the eruption.
  for(int movement=-1;movement<=1;movement+=2) {
    startLevel(0,2); playerX=350;
    spikes[0]={playerX,spikeWarning+spikeDuration,true};
    for(int i=0;i<15;++i) step(0.1f,movement,false);
    assert(life==5);
  }
  // The Warlord generates spaced, visible warnings instead of summoning.
  startLevel(0,2); playerX=arenaStart+41;
  step(0.01f,0,false);
  for(int i=0;i<15;++i) step(0.1f,0,false);
  for(int i=0;i<maxSpikes;++i) {
    assert(spikes[i].active && spikes[i].timer>spikeDuration);
    assert(spikes[i].x>camera && spikes[i].x<camera+320);
    if(i) assert(spikes[i].x-spikes[i-1].x>46);
  }
  for(const auto &z:zombies) assert(z.hp==0);
  stage=DEFEAT;
  updateZombieCrash(6000,true,true,100,140);
  assert(level==2 && stage==ACTIVE_LEVEL && life==5);
  for(const auto &p:spit) assert(!p.active);
  for(const auto &p:spikes) assert(!p.active);
  // Retry resets all encounter state without losing the player's choices.
  female=true; bow=true; startLevel(1000);
  assert(life==5 && bossLife==10 && !bossActive && kills==0 && female && bow);
  for(const auto &z:zombies) assert(z.hp==0);
  for(const auto &a:arrows) assert(!a.active);
  // A short tap between frames is queued until the next simulation update.
  updateZombieCrash(1010,true,true,280,210);
  updateZombieCrash(1040,false,false,0,0);
  bool fired=false;
  for(const auto &a:arrows) fired=fired || a.active;
  assert(fired);
  updateZombieCrash(1050,true,true,20,12);
  assert(gameState==1);
  // Waves relocate even with a stationary camera and deterministic random.
  startLevel(0,2); camera=2280;
  raiseSpikeWarnings(); float old[maxSpikes];
  for(int i=0;i<maxSpikes;++i) old[i]=spikes[i].x;
  raiseSpikeWarnings();
  for(int i=0;i<maxSpikes;++i) assert(fabsf(old[i]-spikes[i].x)>40);
  stage=LEVEL_COMPLETE;
  updateZombieCrash(7000,true,true,100,140);
  assert(level==3 && bossLife==15);
  assert(terrain(180)==ground && terrain(330)==ground-48 && terrain(630)==ground);
  spawnZombie(400); assert(zombies[0].flying);
  float high=zombieFeet(zombies[0]); zombies[0].flightPhase=3.14159f;
  assert(zombieFeet(zombies[0])>high+60);
  // Armory pauses combat, requires one selection, and precedes the arena.
  playerX=2041; step(0.01f,0,false);
  assert(stage==ARMORY && !bossActive);
  float pausedX=playerX; step(1,1,true); assert(playerX==pausedX);
  updateZombieCrash(8000,true,true,40,120);
  assert(stage==ACTIVE_LEVEL && extra==GRENADES && grenades==5 && armoryVisited);
  updateZombieCrash(8001,true,true,180,210); assert(useExtra);
  attack(); assert(grenades==4 && thrown[0].active && thrown[0].vy<0);
  for(int i=0;i<100;++i) updateExtras(0.02f);
  assert(!thrown[0].active);
  for(int i=0;i<4;++i) { attackCooldown=0; attack(); }
  assert(grenades==0); attackCooldown=0; attack(); assert(grenades==0);
  startLevel(0,3); extra=SPEAR; useExtra=true;
  attack(); assert(thrown[0].active && !thrown[0].grenade);
  for(int i=0;i<100;++i) updateExtras(0.02f);
  attackCooldown=0; attack(); assert(thrown[0].active);
  startLevel(0,3); extra=DOG; useExtra=true; dogAvailable=true;
  zombies[0]={playerX+20,0,0,2}; attack(); assert(dogTime==10 && !dogAvailable);
  updateExtras(0.01f); assert(zombies[0].hp==1);
  for(int i=0;i<100;++i) updateExtras(0.1f);
  assert(dogTime==0 && zombies[0].hp==0);
  attack(); assert(dogTime==0);
  // Height matters to melee and arrows; high fliers cannot hit the player.
  startLevel(0,3); bow=false; spawnZombie(playerX+20);
  zombies[0].rising=0; attack(); assert(zombies[0].hp==2);
  zombies[0].flightPhase=3.14159f; attackCooldown=0; attack(); assert(zombies[0].hp==0);
  bossActive=true; hurtBoss(14); assert(bossLife==1 && stage==ACTIVE_LEVEL);
  hurtBoss(1); assert(stage==VICTORY && crownUnlocked && wearCrown);
  startLevel(0); assert(crownUnlocked && wearCrown && extra==NONE && dogTime==0);
  beginZombieCrash(); updateZombieCrash(100,true,true,100,60); assert(!wearCrown);
  puts("Zombie Crash gameplay checks passed");
}
