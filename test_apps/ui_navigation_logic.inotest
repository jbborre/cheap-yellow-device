#include <cassert>
#include <cstdint>
#include <cstdio>
struct TouchButton { int x,y,w,h; };
struct Renderer { void drawRoundRect(int,int,int,int,int,int) {} } gameFrame;
const int COLOR_GOLD=0;
#include "../include/UiNavigation.h"
#define BATTERY_HOST_TEST
#include "../include/BatteryStatus.h"
int main() {
  TouchButton a={0,0,20,20},b={30,0,20,20},c={60,0,20,20};
  const TouchButton *items[]={&a,&b,&c};
  using namespace UiNavigation;
  assert(update(1,items,3,0) && target==&a);
  assert(update(1,items,3,1) && target==&c); // Left wraps.
  assert(update(1,items,3,2) && target==&a); // Right wraps.
  assert(!update(1,items,3,0) && target==&a); // Held buttons do not navigate.
  update(1,items,3,2); assert(target==&b);
  assert(update(2,items,2,0) && target==&a); // New screen resets focus.
  update(3,items,0,0); assert(!visible && target==nullptr); // Gameplay has no focus.
  update(4,items,1,1); assert(target==&a);
  assert(BatteryStatus::fromMillivolts(2000)==0);
  assert(BatteryStatus::fromMillivolts(4200)==100);
  assert(BatteryStatus::fromMillivolts(5000)==100);
  int last=0;
  for (int mv=3300;mv<=4200;++mv) {
    int value=BatteryStatus::fromMillivolts(mv);
    assert(value>=last && value>=0 && value<=100); last=value;
  }
  assert(BatteryStatus::fromMillivolts(3850)==50);
  puts("Menu focus and battery estimate checks passed");
}
