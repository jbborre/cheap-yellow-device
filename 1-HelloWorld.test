#include <TFT_eSPI.h>

TFT_eSPI tft = TFT_eSPI();

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  // // Backlight control
  // pinMode(21, OUTPUT);
  // digitalWrite(21, LOW);
  // Serial.println("Backlight turned on");
  
  // Initialize display
  tft.init();
  tft.setRotation(1);
  
  Serial.println("Display initialized successfully");
  
  // Test 1: Fill with RED
  Serial.println("Filling with RED...");
  tft.fillScreen(TFT_RED);
  delay(2000);
  
  // Test 2: Fill with GREEN
  Serial.println("Filling with GREEN...");
  tft.fillScreen(TFT_GREEN);
  delay(2000);
  
  // Test 3: Fill with BLUE
  Serial.println("Filling with BLUE...");
  tft.fillScreen(TFT_BLUE);
  delay(2000);
  
  // Test 4: Fill with BLACK
  Serial.println("Filling with BLACK...");
  tft.fillScreen(TFT_BLACK);
  delay(1000);
  
  // Test 5: Draw white rectangle
  Serial.println("Drawing WHITE rectangle...");
  tft.drawRect(10, 10, 100, 100, TFT_WHITE);
  delay(2000);
  
  // Test 6: Fill rectangle with YELLOW
  Serial.println("Filling rectangle with YELLOW...");
  tft.fillRect(50, 50, 100, 100, TFT_YELLOW);
}

void loop() {
  delay(100);
}
